# ---------------------------------------------------
# FRONTEND (Node.js / Angular)
# ---------------------------------------------------
# Ignora dependencias sin importar en qué subcarpeta estén
node_modules/

# Directorios de compilación y caché de Angular
dist/
.angular/
.npm/

# ---------------------------------------------------
# BACKEND (Java / Spring Boot)
# ---------------------------------------------------
# Ignora las carpetas target de todos los microservicios
target/
*.jar
*.war
.mvn/wrapper/maven-wrapper.jar

# ---------------------------------------------------
# INFRAESTRUCTURA (Terraform)
# ---------------------------------------------------
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
terraform.tfvars

# ---------------------------------------------------
# SEGURIDAD Y ENTORNO
# ---------------------------------------------------
.env
.env.local

# ---------------------------------------------------
# SISTEMA OPERATIVO Y EDITORES (IDE)
# ---------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Archivos de configuración local y de sistema de Terraform
.terraform/

# Archivos de estado de Terraform (Contienen datos sensibles, ¡no subirlos!)
*.tfstate
*.tfstate.*

# Archivos de variables de Terraform (Suelen contener contraseñas y secretos)
*.tfvars
*.tfvars.json

# Archivos de variables de entorno para inicialización (.envrc de direnv o similares)
.env
.envrc

# Archivos de log de Terraform
*.log
crash.log

# Archivos de invalidación de planes de Terraform
*.tfplan